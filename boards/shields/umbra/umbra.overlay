#include <dt-bindings/zmk/matrix_transform.h>

/ {
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <24>;
        rows = <1>;
        map = <
          RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)
          RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)
          RC(0,8)  RC(0,9)  RC(0,10)  RC(0,11)
          RC(0,12)  RC(0,13)  RC(0,14)  RC(0,15)
          RC(0,16)  RC(0,17)  RC(0,18)  RC(0,19)
          RC(0,20)  RC(0,21)  RC(0,22)  RC(0,23)
        >;
    };
    
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";

        /* Pin mapping mirrors the canonical KMK config from
         * https://github.com/skarrmann/umbra/blob/main/firmware/kmk/kb.py
         * Index = key position (RC(0, idx) in the matrix transform).
         */
        input-gpios
            = <&gpio0 0  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /*  0 */
            , <&gpio0 1  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /*  1 */
            , <&gpio0 2  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /*  2 */
            , <&gpio0 3  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /*  3 */
            , <&gpio0 4  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /*  4 */
            , <&gpio0 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /*  5 */
            , <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /*  6 */
            , <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /*  7 */
            , <&gpio0 27 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /*  8 */
            , <&gpio0 28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /*  9 */
            , <&gpio0 8  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* 10 */
            , <&gpio0 7  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* 11 */
            , <&gpio0 6  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* 12 */
            , <&gpio0 5  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* 13 */
            , <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* 14 */
            , <&gpio0 19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* 15 */
            , <&gpio0 18 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* 16 */
            , <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* 17 */
            , <&gpio0 9  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* 18 */
            , <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* 19 */
            , <&gpio0 11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* 20 */
            , <&gpio0 12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* 21 */
            , <&gpio0 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* 22 */
            , <&gpio0 14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* 23 */
            ;
    };

    physical_layout_main: physical_layout_main {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        kscan = <&kscan0>;
        transform = <&default_transform>;
    };

    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,physical_layout = &physical_layout_main;
    };
};

/* Free the GPIOs that the rp2040_plus board enables for peripherals
 * but the umbra wires up as direct kscan inputs.
 *   i2c0 -> GP4 (SDA), GP5 (SCL)
 *   spi0 -> GP16, GP17, GP18, GP19
 *   adc  -> GP26, GP27, GP28, GP29 (via adc_default pinctrl)
 */
&i2c0 { status = "disabled"; };
&spi0 { status = "disabled"; };
&adc  { status = "disabled"; };
